# Maintainer: the0megastar <https://github.com/the0megastar/Glyph>
pkgname=glyph
pkgver=0.1.1
pkgrel=1
pkgdesc="Customize application launcher icons and display names safely on Linux"
arch=('any')
url="https://github.com/the0megastar/Glyph"
license=('GPL-3.0-or-later')
depends=(
    'python'
    'python-gobject'
    'gtk4'
    'libadwaita'
    'desktop-file-utils'
    'hicolor-icon-theme'
)
makedepends=(
    'git'
    'meson'
    'ninja'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/the0megastar/Glyph/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    arch-meson "Glyph-$pkgver" build
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"
}
