# Maintainer: the0megastar <the0megastar@users.noreply.github.com>
pkgname=glyph
pkgver=0.1.3
pkgrel=1
pkgdesc="Customize application launcher icons and names on Linux"
arch=('any')
url="https://github.com/the0megastar/Glyph"
license=('GPL-3.0-or-later')
depends=(
  'python>=3.10'
  'python-gobject'
  'gtk4>=4.10'
  'libadwaita>=1.5'
  'desktop-file-utils'
  'hicolor-icon-theme'
)
makedepends=(
  'meson>=0.63.0'
  'ninja'
  'python'
)
checkdepends=(
  'python'
  'desktop-file-utils'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir="$pkgdir"
}
